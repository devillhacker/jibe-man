<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>جیب من — مدیریت مالی، ساده و سریع</title>
<link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet">
<style>
:root{
  --red:#ef4444;
  --red-dark:#dc2626;
  --gold:#fbbf24;
  --gold-dark:#f59e0b;
  --dark:#0f172a;
  --gray:#64748b;
}
*{font-family:'Vazirmatn',system-ui,sans-serif;margin:0;padding:0;box-sizing:border-box}
body{
  background:#0f172a;
  color:#f1f5f9;
  line-height:1.7;
  overflow-x:hidden;
}
html{scroll-behavior:smooth}
.container{max-width:1100px;margin:0 auto;padding:0 20px}

/* ===== Header / Nav ===== */
.nav{
  position:fixed;top:0;left:0;right:0;z-index:100;
  background:rgba(15,23,42,.85);
  backdrop-filter:blur(20px);
  border-bottom:1px solid rgba(255,255,255,.05);
  padding:12px 0;
}
.nav-inner{
  display:flex;align-items:center;justify-content:space-between;
  max-width:1100px;margin:0 auto;padding:0 20px;
}
.nav-logo{
  display:flex;align-items:center;gap:10px;
  color:white;font-weight:900;font-size:17px;
}
.nav-logo-box{
  width:36px;height:36px;border-radius:11px;
  background:linear-gradient(135deg,var(--red),var(--red-dark));
  display:flex;align-items:center;justify-content:center;
  color:white;font-weight:900;font-size:18px;
  box-shadow:0 4px 14px rgba(239,68,68,.4);
}
.nav-links{display:flex;gap:24px;font-size:14px}
.nav-links a{color:#cbd5e1;text-decoration:none;transition:color .2s}
.nav-links a:hover{color:var(--gold)}
@media (max-width:768px){.nav-links{display:none}}

/* ===== Hero ===== */
.hero{
  padding:140px 0 80px;
  position:relative;
  overflow:hidden;
}
.hero::before{
  content:'';position:absolute;
  top:-200px;right:-200px;width:600px;height:600px;
  background:radial-gradient(circle,rgba(239,68,68,.25),transparent 70%);
  z-index:0;
}
.hero::after{
  content:'';position:absolute;
  bottom:-300px;left:-200px;width:600px;height:600px;
  background:radial-gradient(circle,rgba(251,191,36,.15),transparent 70%);
  z-index:0;
}
.hero-inner{
  position:relative;z-index:1;
  display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;
}
@media (max-width:900px){
  .hero-inner{grid-template-columns:1fr;gap:40px;text-align:center}
  .hero{padding:120px 0 60px}
}
.hero-badge{
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(251,191,36,.15);
  border:1px solid rgba(251,191,36,.3);
  padding:8px 16px;border-radius:100px;
  color:var(--gold);font-size:13px;font-weight:700;
  margin-bottom:24px;
}
.hero-badge span{
  width:6px;height:6px;border-radius:50%;
  background:var(--gold);animation:blink 1.5s infinite;
}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
.hero h1{
  font-size:52px;font-weight:900;line-height:1.2;
  margin-bottom:20px;letter-spacing:-1px;
}
@media (max-width:768px){.hero h1{font-size:38px}}
.hero h1 .highlight{
  background:linear-gradient(135deg,var(--red),var(--gold));
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
  background-clip:text;
}
.hero p{
  font-size:18px;color:#94a3b8;margin-bottom:36px;line-height:1.9;
}
.hero-ctas{display:flex;gap:14px;flex-wrap:wrap}
@media (max-width:900px){.hero-ctas{justify-content:center}}
.btn{
  display:inline-flex;align-items:center;gap:10px;
  padding:16px 28px;border-radius:16px;
  font-size:15px;font-weight:800;text-decoration:none;
  border:none;cursor:pointer;transition:all .2s;
  font-family:inherit;
}
.btn-primary{
  background:linear-gradient(135deg,var(--red),var(--red-dark));
  color:white;box-shadow:0 8px 24px rgba(239,68,68,.4);
}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 12px 32px rgba(239,68,68,.5)}
.btn-secondary{
  background:rgba(251,191,36,.12);
  border:2px solid rgba(251,191,36,.3);
  color:var(--gold);
}
.btn-secondary:hover{background:rgba(251,191,36,.2)}

/* ===== Phone Mockup ===== */
.phone-wrap{
  display:flex;justify-content:center;align-items:center;
  position:relative;
}
.phone{
  width:280px;height:560px;
  background:linear-gradient(135deg,#1e293b,#0f172a);
  border-radius:44px;
  border:8px solid #1e293b;
  box-shadow:
    0 30px 60px rgba(0,0,0,.5),
    0 0 0 2px rgba(255,255,255,.05),
    inset 0 0 20px rgba(0,0,0,.3);
  position:relative;
  overflow:hidden;
  animation:float 6s ease-in-out infinite;
}
@keyframes float{
  0%,100%{transform:translateY(0) rotate(-2deg)}
  50%{transform:translateY(-15px) rotate(-2deg)}
}
.phone::before{
  content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);
  width:120px;height:22px;
  background:#0f172a;border-radius:0 0 16px 16px;z-index:10;
}
.phone-screen{
  width:100%;height:100%;padding:44px 16px 16px;
  background:#f8fafc;
  color:#0f172a;
  overflow:hidden;
  position:relative;
}
.ps-header{
  display:flex;align-items:center;gap:10px;margin-bottom:16px;
}
.ps-logo{
  width:32px;height:32px;border-radius:10px;
  background:linear-gradient(135deg,var(--red),var(--red-dark));
  display:flex;align-items:center;justify-content:center;
  color:white;font-weight:900;font-size:15px;
}
.ps-title{font-size:13px;font-weight:800;color:#1e293b}
.ps-sub{font-size:9px;color:#94a3b8}
.ps-card{
  background:linear-gradient(135deg,#6366f1,#8b5cf6);
  border-radius:14px;padding:14px;color:white;margin-bottom:12px;
}
.ps-card-title{font-size:9px;opacity:.8;margin-bottom:4px}
.ps-card-value{font-size:18px;font-weight:900}
.ps-amounts{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px}
.ps-amt{
  background:white;border-radius:10px;padding:10px;border:1px solid #f1f5f9;
}
.ps-amt-lbl{font-size:8px;color:#94a3b8;margin-bottom:2px}
.ps-amt-val{font-size:11px;font-weight:800}
.ps-amt-val.green{color:#10b981}
.ps-amt-val.red{color:#ef4444}
.ps-tx{background:white;border-radius:10px;padding:10px;border:1px solid #f1f5f9;margin-bottom:6px}
.ps-tx-row{display:flex;align-items:center;gap:8px}
.ps-tx-emoji{
  width:28px;height:28px;border-radius:8px;
  background:#fef3c7;
  display:flex;align-items:center;justify-content:center;font-size:14px;
}
.ps-tx-info{flex:1}
.ps-tx-name{font-size:10px;font-weight:700;color:#334155}
.ps-tx-time{font-size:8px;color:#94a3b8}
.ps-tx-amount{font-size:10px;font-weight:800;color:#ef4444}
.ps-fab{
  position:absolute;bottom:20px;left:50%;transform:translateX(-50%);
  width:48px;height:48px;border-radius:50%;
  background:linear-gradient(135deg,var(--red),var(--red-dark));
  display:flex;align-items:center;justify-content:center;
  color:white;font-size:24px;font-weight:300;
  box-shadow:0 8px 20px rgba(239,68,68,.4);
}

/* ===== Section ===== */
.section{padding:80px 0;position:relative}
.section-title{
  text-align:center;margin-bottom:60px;
}
.section-title h2{
  font-size:42px;font-weight:900;margin-bottom:16px;
  letter-spacing:-1px;
}
@media (max-width:768px){.section-title h2{font-size:30px}}
.section-title h2 .highlight{
  background:linear-gradient(135deg,var(--red),var(--gold));
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
  background-clip:text;
}
.section-title p{color:#94a3b8;font-size:17px;max-width:600px;margin:0 auto}
.section-title .bar{
  width:60px;height:5px;border-radius:3px;
  background:linear-gradient(90deg,var(--red),var(--gold));
  margin:0 auto 24px;
}

/* ===== Features ===== */
.features-grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:20px;
}
@media (max-width:900px){.features-grid{grid-template-columns:repeat(2,1fr)}}
@media (max-width:600px){.features-grid{grid-template-columns:1fr}}
.feature{
  background:linear-gradient(135deg,rgba(30,41,59,.6),rgba(15,23,42,.6));
  border:1px solid rgba(255,255,255,.06);
  border-radius:20px;padding:26px;
  transition:all .3s;
  position:relative;overflow:hidden;
}
.feature::before{
  content:'';position:absolute;top:0;right:0;width:100px;height:100px;
  background:radial-gradient(circle,rgba(239,68,68,.15),transparent 70%);
  opacity:0;transition:opacity .3s;
}
.feature:hover{
  transform:translateY(-6px);
  border-color:rgba(251,191,36,.3);
  box-shadow:0 20px 40px rgba(0,0,0,.3);
}
.feature:hover::before{opacity:1}
.feature-icon{
  width:56px;height:56px;border-radius:16px;
  display:flex;align-items:center;justify-content:center;
  margin-bottom:18px;position:relative;z-index:1;
}
.feature-icon svg{width:28px;height:28px}
.feature h3{
  font-size:17px;font-weight:800;margin-bottom:8px;
  color:#f1f5f9;position:relative;z-index:1;
}
.feature p{
  font-size:13.5px;color:#94a3b8;line-height:1.8;
  position:relative;z-index:1;
}

/* ===== Steps ===== */
.steps{
  display:grid;grid-template-columns:repeat(3,1fr);gap:30px;
  position:relative;
}
@media (max-width:900px){.steps{grid-template-columns:1fr;gap:50px}}
.step{
  text-align:center;position:relative;
}
.step-num{
  width:80px;height:80px;border-radius:50%;
  background:linear-gradient(135deg,var(--red),var(--gold));
  display:flex;align-items:center;justify-content:center;
  font-size:36px;font-weight:900;color:white;
  margin:0 auto 24px;
  box-shadow:0 12px 30px rgba(239,68,68,.35);
  position:relative;z-index:2;
}
.step h3{font-size:20px;font-weight:800;margin-bottom:12px;color:#f1f5f9}
.step p{color:#94a3b8;font-size:14px;max-width:280px;margin:0 auto}
@media (min-width:901px){
  .steps::before{
    content:'';position:absolute;
    top:40px;right:15%;left:15%;height:3px;
    background:repeating-linear-gradient(90deg,rgba(251,191,36,.4) 0 8px,transparent 8px 16px);
    z-index:1;
  }
}

/* ===== Comparison ===== */
.comparison{
  display:grid;grid-template-columns:1fr 1fr;gap:24px;
  max-width:800px;margin:0 auto;
}
@media (max-width:700px){.comparison{grid-template-columns:1fr}}
.comp-card{
  border-radius:24px;padding:32px 28px;
  border:2px solid;
}
.comp-card.bad{
  background:rgba(100,116,139,.08);
  border-color:rgba(100,116,139,.2);
}
.comp-card.good{
  background:linear-gradient(135deg,rgba(239,68,68,.1),rgba(251,191,36,.05));
  border-color:rgba(251,191,36,.3);
  position:relative;
}
.comp-card.good::before{
  content:'⭐ پیشنهاد ما';
  position:absolute;top:-12px;right:24px;
  background:linear-gradient(135deg,var(--red),var(--gold));
  color:white;font-size:11px;font-weight:800;
  padding:5px 14px;border-radius:100px;
}
.comp-card h3{
  font-size:20px;font-weight:900;margin-bottom:20px;
  display:flex;align-items:center;gap:10px;
}
.comp-card ul{list-style:none}
.comp-card li{
  padding:10px 0;
  display:flex;align-items:flex-start;gap:10px;
  font-size:14px;color:#cbd5e1;
  border-bottom:1px solid rgba(255,255,255,.05);
}
.comp-card li:last-child{border-bottom:none}
.comp-card li .icon{flex-shrink:0;font-size:18px}
.comp-card.bad li .icon{color:#94a3b8}
.comp-card.good li .icon{color:#10b981}

/* ===== Stats ===== */
.stats{
  display:grid;grid-template-columns:repeat(4,1fr);gap:20px;
  max-width:900px;margin:0 auto;
}
@media (max-width:700px){.stats{grid-template-columns:repeat(2,1fr)}}
.stat{
  text-align:center;padding:24px 16px;
  background:linear-gradient(135deg,rgba(30,41,59,.6),rgba(15,23,42,.6));
  border:1px solid rgba(255,255,255,.06);
  border-radius:18px;
}
.stat-num{
  font-size:36px;font-weight:900;
  background:linear-gradient(135deg,var(--red),var(--gold));
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
  background-clip:text;
  margin-bottom:6px;
}
.stat-lbl{font-size:13px;color:#94a3b8}

/* ===== CTA Final ===== */
.cta-final{
  text-align:center;padding:80px 20px;
  background:linear-gradient(135deg,rgba(239,68,68,.1),rgba(251,191,36,.05));
  border-radius:32px;margin:60px 0;
  border:1px solid rgba(251,191,36,.2);
  position:relative;overflow:hidden;
}
.cta-final::before{
  content:'';position:absolute;
  top:-100px;right:-100px;width:400px;height:400px;
  background:radial-gradient(circle,rgba(239,68,68,.2),transparent 70%);
}
.cta-final h2{
  font-size:38px;font-weight:900;margin-bottom:16px;
  position:relative;z-index:1;
}
@media (max-width:768px){.cta-final h2{font-size:26px}}
.cta-final p{color:#94a3b8;font-size:17px;margin-bottom:36px;position:relative;z-index:1}

/* ===== QR ===== */
.qr-box{
  display:inline-block;padding:20px;
  background:white;border-radius:20px;
  margin-top:24px;position:relative;z-index:1;
}
.qr-box svg{display:block;width:160px;height:160px}
.qr-label{
  text-align:center;color:#0f172a;
  font-size:12px;font-weight:700;margin-top:8px;
}

/* ===== Footer ===== */
.footer{
  padding:40px 20px;text-align:center;
  border-top:1px solid rgba(255,255,255,.05);
  color:#64748b;font-size:13px;
}
.footer a{color:var(--gold);text-decoration:none}
.footer .credit{
  margin-top:12px;font-size:12px;
}

/* ===== Animations ===== */
.fade-in{
  opacity:0;transform:translateY(30px);
  transition:all .7s cubic-bezier(.16,1,.3,1);
}
.fade-in.visible{
  opacity:1;transform:translateY(0);
}
</style>
</head>
<body>

<!-- ============ NAV ============ -->
<nav class="nav">
  <div class="nav-inner">
    <div class="nav-logo">
      <div class="nav-logo-box">ج</div>
      <span>جیب من</span>
    </div>
    <div class="nav-links">
