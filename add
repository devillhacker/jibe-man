    </div>
  </div>
</nav>

<!-- ============ HERO ============ -->
<section class="hero">
  <div class="container hero-inner">
    <div>
      <div class="hero-badge">
        <span></span>
        نسخه ۱.۰.۱ — جدیدترین
      </div>
      <h1>
        پولت رو <span class="highlight">کنترل</span> کن! 🚀
      </h1>
      <p>
        جیب من — مدیریت مالی، ساده و سریع.<br>
        ثبت هزینه در چند ثانیه، اقساط با یادآوری، گزارش‌های هوشمند و سینک ابری.
      </p>
      <div class="hero-ctas">
        <a href="https://devillhacker.github.io/jibe-man/" class="btn btn-primary">
          📲 دانلود رایگان
        </a>
        <a href="#features" class="btn btn-secondary">
          ✨ قابلیت‌ها
