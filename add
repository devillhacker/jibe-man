      </div>
    </div>
    <div class="phone-wrap">
      <div class="phone">
        <div class="phone-screen">
          <div class="ps-header">
            <div class="ps-logo">ج</div>
            <div>
              <div class="ps-title">جیب من</div>
              <div class="ps-sub">۲۵ شهریور ۱۴۰۴</div>
            </div>
          </div>
          <div class="ps-card">
            <div class="ps-card-title">💰 مجموع موجودی</div>
            <div class="ps-card-value">۴,۸۰۰,۰۰۰ تومان</div>
          </div>
          <div class="ps-amounts">
            <div class="ps-amt">
