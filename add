              <div class="ps-amt-val red">۱,۲۰۰,۰۰۰</div>
            </div>
            <div class="ps-amt">
              <div class="ps-amt-lbl">📈 درآمد</div>
              <div class="ps-amt-val green">۵,۰۰۰,۰۰۰</div>
